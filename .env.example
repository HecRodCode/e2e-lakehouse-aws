# Replace these placeholders with the bucket names from Terraform outputs.
AWS_PROFILE=lakehouse
AWS_REGION=us-east-2

PROJECT=lakehouse
ENV=dev
OWNER=your-name
ATHENA_WORKGROUP=lakehouse

DATALAKE_BUCKET=your-datalake-bucket
ATHENA_RESULTS_BUCKET=your-athena-results-bucket

DBT_ATHENA_DATA_DIR=s3://your-datalake-bucket/gold/dbt/
DBT_ATHENA_STAGING_DIR=s3://your-athena-results-bucket/results/